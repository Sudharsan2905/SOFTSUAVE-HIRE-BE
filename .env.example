# ── App Settings ────────────────────────────────────────────────────────────
APP_NAME=Talentia
APP_VERSION=1.0.0
APP_DESCRIPTION=Talentia is a platform to manage the hiring process.
LOG_LEVEL="INFO"
MAX_REACCESS_COUNT=3
MAX_MALPRACTICE_COUNT=3
HOLD_DELAY_SECONDS=60

# MongoDB # ── `MongoDB ──────────────────────────────────────────────────────
MONGODB_URL=mongodb://localhost:27017
DATABASE_NAME=your_database_name

# ── JWT ─────────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your-super-secret-jwt-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=360
REFRESH_TOKEN_EXPIRE_DAYS=1

# ── Google OAuth (optional) ─────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ── OpenAI (optional — required for AI question generation) ─────────────────
OPENAI_API_KEY=your-openai-api-key

# ── Email / SMTP (optional — required for sending invite emails) ────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASSWORD=your-smtp-password

# ── AWS ─────────────────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=your_key
AWS_SECRET_ACCESS_KEY=your_secret
AWS_REGION=your_region
S3_BUCKET_NAME=your_bucket_name

# ── LiveKit ─────────────────────────────────────────────────────────────────
LIVEKIT_API_KEY=your_key
LIVEKIT_API_SECRET=your_secret
LIVEKIT_HOST=wss://your.livekit.server

# ── CORS ────────────────────────────────────────────────────────────────────
# JSON array of allowed origins
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
# Regex to allow dynamic origins (e.g. VS Code devtunnels — changes every session)
CORS_ORIGIN_REGEX=https://.*\.devtunnels\.ms

# ── Round timing (server-owned; the frontend has no default) ────────────────
DEFAULT_ROUND_MINUTES=30
SETUP_ALLOWANCE_MINUTES=15
SUBMIT_GRACE_SECONDS=30

# ── Auto-submit reaper (submits sessions past their deadline) ───────────────
# An APScheduler cron job on a background thread inside the API (never blocks the event
# loop). Every worker runs it; a Mongo lease lets exactly one execute each cycle.
# An abandoned session is auto-submitted within ~ REAPER_CRON_MINUTES + REAPER_GRACE_SECONDS
# of its deadline. Manual/backfill run:  python -m app.components.scheduler.submission_reaper
REAPER_ENABLED=true
REAPER_CRON_MINUTES=10
REAPER_GRACE_SECONDS=60       # a session is overdue at deadline + grace
REAPER_RUN_ON_STARTUP=true    # one extra run ~30s after boot (clears backlog after downtime)
REAPER_LEASE_SECONDS=300

# ── Performance ─────────────────────────────────────────────────────────────
MONGO_MAX_POOL_SIZE=200
USER_CACHE_TTL_SECONDS=5
WS_PING_SYNC_SECONDS=30
# NOTE: leave RATELIMIT_ENABLED *unset* to disable rate limiting. Setting it to "0"
# actually ENABLES it (the string "0" is truthy to slowapi).

# ── Scaling to several workers / instances (optional) ───────────────────────
# Leave REDIS_URL empty for a single process (default; no Redis needed).
# With Redis you may run `uvicorn --workers N` / several instances behind a load balancer.
REDIS_URL=
WS_PRESENCE_TTL_SECONDS=45
HOLD_SWEEP_GRACE_SECONDS=30

# ── Essay scoring (LLM) ─────────────────────────────────────────────────────
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=30
SCORING_LLM_CONCURRENCY=8
SCORING_LLM_MAX_ATTEMPTS=4
SCORING_MAX_ATTEMPTS=3
